---
import type { DiagramEdge } from "../data/diagrams";

type Props = { edge: DiagramEdge; index: number };

const { edge, index } = Astro.props;
---

<path d={edge.path} class="dg-edge" pathLength="1"></path>
{
  edge.hasPacket && (
    <circle r="4" class="dg-packet">
      <animateMotion dur="2.4s" begin={`-${(index * 0.35).toFixed(2)}s`} repeatCount="indefinite" path={edge.path} />
    </circle>
  )
}
