---
import { getContent, localePath } from "../i18n";
import type { Locale } from "../i18n/types";
import { btnIcon } from "../styles/classes";
import Icon from "./Icon.astro";
import LogoMark from "./LogoMark.astro";

type Props = { locale: Locale; path: string };

const { locale, path } = Astro.props;
const { nav } = getContent(locale);
const otherLocale: Locale = locale === "en" ? "vi" : "en";
const links = [
  { label: nav.projects, href: localePath(locale, "/projects/"), match: "/projects" },
  { label: nav.experience, href: localePath(locale, "/experience/"), match: "/experience" },
  { label: nav.resume, href: localePath(locale, "/resume/"), match: "/resume" },
  { label: nav.contact, href: `${localePath(locale, "/")}#contact`, match: "#" },
];
---

<div data-header class="sticky top-0 z-40 border-b border-transparent print:hidden">
<header class="mx-auto flex h-16 w-full max-w-7xl items-center justify-between gap-4 px-4 sm:px-6">
  <a href={localePath(locale, "/")} class="inline-flex min-h-8 items-center gap-2.5 text-base font-semibold text-foreground"><span class="btn-glow flex size-8 shrink-0 items-center justify-center rounded-lg"><LogoMark /></span>vinhnq.com</a>
  <div class="flex items-center gap-2 md:gap-6">
    <nav class="hidden items-center gap-6 text-sm text-muted md:flex" aria-label="Main">
      {links.map((link) => <a class="nav-link hover:text-foreground aria-[current]:font-medium aria-[current]:text-foreground" aria-current={path.startsWith(link.match) ? "page" : undefined} href={link.href}>{link.label}</a>)}
    </nav>
    <div class="flex items-center gap-2">
      <a class={`${btnIcon} text-sm font-medium`} href={localePath(otherLocale, path)} hreflang={otherLocale} lang={otherLocale} aria-label={nav.language}>{otherLocale.toUpperCase()}</a>
      <button type="button" class={btnIcon} data-theme-toggle aria-label={nav.theme}>
        <Icon name="sun" class="hidden size-4 dark:block" />
        <Icon name="moon" class="size-4 dark:hidden" />
      </button>
      <button type="button" class={`${btnIcon} md:hidden`} popovertarget="mobile-menu" aria-label={nav.menu}>
        <Icon name="menu" />
      </button>
    </div>
  </div>
  <nav id="mobile-menu" popover class="fixed inset-x-4 top-16 m-0 w-auto rounded-2xl border border-border bg-surface-overlay p-2 text-foreground shadow-popover" aria-label="Mobile">
    <div class="grid gap-1">
      {links.map((link) => <a class="flex min-h-11 items-center rounded-xl px-3 text-sm hover:bg-item-hover" href={link.href}>{link.label}</a>)}
    </div>
  </nav>
</header>
</div>
