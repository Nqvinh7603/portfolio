---
// Dải chữ chạy ngang. Bản `isOutline` là chữ rỗng cỡ lớn, chạy ngược chiều.
type Props = { items?: string[]; isOutline?: boolean };

const stack = ["Java 21", "Spring Boot", "Kafka", "PostgreSQL", "Redis", "AWS ECS Fargate", "Docker", "GitHub Actions", "ISO 20022", "HSM", "Linux"];
const { items = stack, isOutline = false } = Astro.props;
const renderItems = [...items, ...items];
---

<div class:list={["marquee overflow-hidden [mask-image:linear-gradient(90deg,transparent,black_8%,black_92%,transparent)]", isOutline ? "marquee-outline py-3" : "border-y border-border-strong py-5"]} aria-label={items.join(", ")}>
  <div class="marquee-track flex items-center gap-10" aria-hidden="true">
    {
      renderItems.map((item, index) => (
        <>
          <span class:list={["whitespace-nowrap", isOutline ? "text-6xl font-semibold tracking-tight sm:text-8xl" : "text-2xl sm:text-3xl", index >= items.length && "marquee-copy", !isOutline && (index % 3 === 1 ? "accent" : "font-light text-foreground/80")]}>{item}</span>
          <span class:list={["rotate-45 border border-muted", isOutline ? "size-3" : "size-1.5", index >= items.length && "marquee-copy"]}></span>
        </>
      ))
    }
  </div>
</div>
