---
const stack = ["Java 21", "Spring Boot", "Kafka", "PostgreSQL", "Redis", "AWS ECS Fargate", "Docker", "GitHub Actions", "ISO 20022", "HSM", "Linux"];
const renderItems = [...stack, ...stack];
---

<div class="marquee overflow-hidden border-y border-border-strong py-5 [mask-image:linear-gradient(90deg,transparent,black_8%,black_92%,transparent)]" aria-label={stack.join(", ")}>
  <div class="marquee-track flex items-center gap-10" aria-hidden="true">
    {
      renderItems.map((item, index) => (
        <>
          <span class:list={["text-2xl whitespace-nowrap sm:text-3xl", index >= stack.length && "marquee-copy", index % 3 === 1 ? "accent" : "font-light text-foreground/80"]}>{item}</span>
          <span class:list={["size-1.5 rotate-45 border border-muted", index >= stack.length && "marquee-copy"]}></span>
        </>
      ))
    }
  </div>
</div>
