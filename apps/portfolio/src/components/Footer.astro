---
import { getContent } from "../i18n";
import type { Locale } from "../i18n/types";
import { linkText } from "../styles/classes";

type Props = { locale: Locale };

const { name, nav } = getContent(Astro.props.locale);
---

<footer class="flex flex-col gap-3 border-t border-border-strong py-6 text-sm text-muted md:flex-row md:items-center md:justify-between print:hidden">
  <p>© 2026 {name.full}</p>
  <p class="flex flex-wrap items-center gap-x-4 gap-y-1">
    <a class={linkText} href="mailto:contact@vinhnq.com">Email</a>
    <a class={linkText} href="https://github.com/Nqvinh7603">GitHub</a>
    <a class={linkText} href="https://linkedin.com/in/nqvinh76">LinkedIn</a>
    <a class={linkText} href="https://github.com/Nqvinh7603/portfolio">{nav.source}</a>
  </p>
</footer>
