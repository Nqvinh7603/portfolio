---
import type { DiagramNode } from "../data/architecture";

type Props = { node: DiagramNode };

const { node } = Astro.props;
const centerX = node.x + node.w / 2;
const centerY = node.y + node.h / 2;
---

<rect x={node.x} y={node.y} width={node.w} height={node.h} rx="10" class:list={["dg-node", node.isKey && "dg-node-key"]}></rect>
{
  node.sub ? (
    <>
      <text x={centerX} y={centerY - 3} text-anchor="middle" class="dg-title">{node.title}</text>
      <text x={centerX} y={centerY + 15} text-anchor="middle" class="dg-sub">{node.sub}</text>
    </>
  ) : (
    <text x={centerX} y={centerY + 5} text-anchor="middle" class="dg-title">{node.title}</text>
  )
}
