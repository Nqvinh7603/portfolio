---
import { getContent } from "../../../i18n";
import type { Project } from "../../../i18n/types";
import Layout from "../../../layouts/Layout.astro";
import ProjectDetail from "../../../views/ProjectDetail.astro";

export function getStaticPaths() {
  return getContent("vi").projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
---

<Layout locale="vi" path={`/projects/${project.slug}/`} title={project.name} description={project.problem ?? project.domain}>
  <ProjectDetail locale="vi" project={project} />
</Layout>
