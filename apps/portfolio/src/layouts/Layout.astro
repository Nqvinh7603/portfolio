---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { getContent, localePath, locales } from "../i18n";
import type { Locale } from "../i18n/types";

type Props = { locale: Locale; path: string; title?: string; description?: string };

const { locale, path, title, description } = Astro.props;
const content = getContent(locale);
const pageTitle = title ? `${title} · ${content.name.full}` : content.meta.title;
const pageDescription = description ?? content.meta.description;
const canonicalUrl = new URL(localePath(locale, path), Astro.site);
const ogImage = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang={locale} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    {locales.map((alternate) => <link rel="alternate" hreflang={alternate} href={new URL(localePath(alternate, path), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(path, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#05060f" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Chạy trước khi vẽ để không nháy sai giao diện. Mặc định là tối.
      document.documentElement.classList.add("js");
      try {
        if (sessionStorage.getItem("booted") || location.pathname !== "/" && location.pathname !== "/vi/") document.documentElement.classList.add("no-boot");
      } catch {
        document.documentElement.classList.add("no-boot");
      }
      try {
        document.documentElement.classList.toggle("dark", localStorage.getItem("theme") !== "light");
      } catch {}
    </script>
  </head>
  <body class="bg-background font-sans text-foreground">
    <canvas data-globe-canvas class="pointer-events-none fixed inset-0 -z-10 h-svh w-full opacity-0 print:hidden" aria-hidden="true"></canvas>
    <div data-boot class="fixed inset-0 z-[60] place-content-center justify-items-center gap-4 bg-background print:hidden" aria-hidden="true">
      <p class="text-sm tracking-[0.3em] text-muted">VINHNQ.COM</p>
      <p class="text-6xl font-light tabular-nums text-foreground" data-boot-count>000</p>
      <div class="h-px w-48 overflow-hidden bg-border-strong"><div data-boot-bar class="h-full origin-left bg-primary"></div></div>
    </div>
    <div data-progress class="fixed inset-x-0 top-0 z-50 h-0.5 print:hidden" aria-hidden="true"></div>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-surface focus:px-3 focus:py-2 focus:text-sm print:hidden">{content.nav.skip}</a>
    <Header locale={locale} path={path} />
    <main id="main" class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <slot />
      <Footer locale={locale} />
    </main>
    <script is:inline>
      document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        try {
          localStorage.setItem("theme", isDark ? "dark" : "light");
        } catch {}
      });
      // SMIL không tự theo prefers-reduced-motion nên phải dừng bằng tay.
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
        for (const svg of document.querySelectorAll("[data-diagram]")) svg.pauseAnimations();
      }
    </script>
    <script>
      import "../scripts/motion";
    </script>
  </body>
</html>
