---
import ArchitectureDiagram from "../components/ArchitectureDiagram.astro";
import Icon from "../components/Icon.astro";
import Marquee from "../components/Marquee.astro";
import Simulation from "../components/Simulation.astro";
import Title from "../components/Title.astro";
import { getContent, localePath } from "../i18n";
import type { Locale } from "../i18n/types";
import { btnOutline, btnPrimary, linkText, sectionLabel, sectionTitle } from "../styles/classes";

type Props = { locale: Locale };

const { locale } = Astro.props;
const content = getContent(locale);
const featured = content.projects.filter((project) => project.decisions && project.slug !== "straffico");
const { labels } = content;
const rail = [
  { id: "top", label: "00" },
  { id: "about", label: "01" },
  { id: "simulation", label: "02" },
  { id: "work", label: "03" },
  { id: "experience", label: "04" },
  { id: "contact", label: "05" },
];
const heroName = `${content.name.first} *${content.name.last}*`;
// Tách con số khỏi phần chữ để con số đứng riêng cỡ lớn: "3 years", "Giải thưởng 2025".
const facts = content.facts.map(([value, label]) => {
  const number = value.match(/\d+/)?.[0] ?? "";
  return { number, unit: value.replace(number, "").trim(), label };
});
const projectNames = content.projects.map((project) => project.name);
---

<nav data-rail class="glass fixed top-1/2 right-4 z-30 hidden -translate-y-1/2 rounded-2xl border border-border-strong px-2.5 py-2 xl:block print:hidden" aria-label="Sections">
  {rail.map((item) => <a href={`#${item.id}`}>{item.label}</a>)}
</nav>

<section id="top" data-globe="0.62 -0.25 1.2 1" data-globe-narrow="0 -1.98 1.55 1" class="grid min-h-[calc(100svh-64px)] content-center py-8">
  <div data-hero class="grid gap-8 lg:gap-10">
    <div class="grid justify-items-start gap-5 sm:gap-6">
      <p data-enter style="--d: 150ms" class="glass inline-flex min-h-9 items-center gap-2.5 rounded-full border border-border-strong px-4 text-sm text-muted">
        <span class="live-dot" aria-hidden="true"></span>{content.hero.location}<span hidden class="inline-flex items-center gap-2.5"><span aria-hidden="true">·</span><time data-clock class="tabular-nums text-foreground"></time></span>
      </p>
      <Title as="h1" text={heroName} hasReveal={false} class="text-[clamp(2.9rem,min(10.6vw,15.5svh),10rem)] leading-[0.98] font-bold tracking-[-0.045em] text-foreground [&>span]:block" />
      <div class="grid max-w-xl gap-4">
        <p data-enter style="--d: 400ms" class="text-2xl font-medium text-foreground sm:text-3xl" data-scramble>{content.hero.eyebrow}</p>
        <p data-enter style="--d: 550ms" class="text-base leading-relaxed text-pretty text-muted sm:text-lg">{content.hero.statement}</p>
        <div data-enter style="--d: 700ms" class="grid grid-cols-2 gap-3 sm:flex sm:flex-wrap">
          <a data-magnet class={`${btnPrimary} col-span-2`} href={content.cvFile} download><Icon name="download" />{content.actions.downloadCv}</a>
          <a data-magnet class={btnOutline} href="#work">{content.actions.viewProjects}<Icon name="arrowRight" /></a>
          <a data-magnet class={btnOutline} href="https://github.com/Nqvinh7603">GitHub</a>
        </div>
      </div>
    </div>
    <dl data-enter style="--d: 900ms" class="hero-facts glass grid grid-cols-2 rounded-2xl border border-border-strong lg:grid-cols-4">
      {
        facts.map((fact) => (
          <div class="grid content-start gap-1.5 p-4 sm:px-6 sm:py-5">
            <dt class="flex flex-wrap items-baseline gap-x-2">
              <span class="stat-number text-4xl leading-none font-semibold tracking-tight tabular-nums sm:text-5xl" data-count>{fact.number}</span>
              <span class="text-base font-medium text-foreground">{fact.unit}</span>
            </dt>
            <dd class="text-sm text-pretty text-muted">{fact.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<div class="grid gap-2">
  <Marquee />
  <Marquee items={projectNames} isOutline />
</div>

<section id="about" data-globe="1.25 0 1.05 0.9" class="grid min-h-svh scroll-mt-20 content-center gap-12 py-20 lg:gap-16 lg:py-28">
  <div class="grid gap-6">
    <p class={sectionLabel}><span class="text-primary">01</span><span data-scramble>{labels.about}</span></p>
    <div class="flex flex-wrap items-center gap-5 sm:gap-8">
      <Title text={content.about.title} class={sectionTitle} />
      <div data-reveal class="avatar-ring size-16 shrink-0 sm:size-24"><img src="/avatar.jpg" alt={content.name.full} width="96" height="96" loading="lazy" class="size-full rounded-full object-cover" /></div>
    </div>
  </div>
  <p data-scrub-words class="max-w-5xl text-3xl leading-[1.22] font-medium tracking-tight text-pretty text-foreground sm:text-5xl sm:leading-[1.16]">
    {content.about.body.split(" ").map((word) => <><span data-word>{word}</span>{" "}</>)}
  </p>
  <dl class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      content.about.focus.map(([label, items], index) => (
        <div data-reveal data-spotlight class="glass grid content-start gap-4 rounded-2xl border border-border-strong p-5">
          <dt class="flex items-baseline justify-between gap-3">
            <span class="text-xl font-semibold text-foreground">{label}</span>
            <span class="text-sm tabular-nums text-muted">0{index + 1}</span>
          </dt>
          <dd>
            <ul class="flex flex-wrap gap-2 text-sm text-foreground">
              {items.split(", ").map((item) => <li class="rounded-full border border-border-strong px-3 py-1">{item}</li>)}
            </ul>
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<section id="simulation" data-globe="-1.4 0.1 1 0.22" class="grid scroll-mt-20 gap-10 py-20 lg:grid-cols-12 lg:gap-12 lg:py-28">
  <div class="grid content-start gap-6 lg:col-span-4">
    <p class={sectionLabel}><span class="text-primary">02</span><span data-scramble>{labels.simulation}</span></p>
    <Title text={content.simulation.title} class={sectionTitle} />
    <p data-reveal class="text-lg leading-relaxed text-pretty text-muted">{content.simulation.intro}</p>
  </div>
  <div data-reveal class="min-w-0 lg:col-span-8"><Simulation locale={locale} /></div>
</section>

<section id="work" data-globe="1.25 0.2 1.1 0.1" class="grid scroll-mt-20 gap-14 py-20 lg:gap-24 lg:py-28">
  <div class="grid gap-6">
    <p class={sectionLabel}><span class="text-primary">03</span><span data-scramble>{labels.work}</span></p>
    <Title text={content.work.title} class={sectionTitle} />
  </div>
  <div data-stack class="flex flex-col gap-6 lg:gap-10">
  {
    featured.map((project, index) => {
      const href = localePath(locale, `/projects/${project.slug}/`);
      return (
        <article data-stack-card data-spotlight class="stack-card grid items-center gap-6 rounded-3xl border border-border-strong p-5 sm:p-8 lg:grid-cols-12 lg:gap-12 lg:p-10">
          <div data-stack-shade class="stack-shade" aria-hidden="true"></div>
          <div data-reveal class="grid gap-4 lg:col-span-5">
            <p class="flex items-baseline gap-2"><span class="accent w-fit text-4xl font-semibold tabular-nums">0{index + 1}</span><span class="text-sm text-muted">/ 0{featured.length}</span></p>
            <div class="grid gap-1">
              <h3 class="text-3xl font-semibold tracking-tight text-foreground sm:text-4xl" style={`view-transition-name: project-${project.slug}`}><a class="transition-colors hover:text-primary" href={href}>{project.name}</a></h3>
              <p class="text-base text-foreground">{project.domain}</p>
              <p class="text-sm text-pretty text-muted">{project.role} · {project.meta}</p>
            </div>
            <ul class="grid gap-2 text-base leading-relaxed text-pretty text-muted">
              {project.points.slice(0, 3).map((point) => <li>{point}</li>)}
            </ul>
            <ul class="flex flex-wrap gap-2 text-sm text-foreground">
              {project.stack.slice(0, 3).map((item) => <li class="glass rounded-full border border-border-strong px-3 py-1">{item}</li>)}
            </ul>
            <div class="flex flex-wrap gap-x-5 gap-y-1">
              <a class={`${linkText} text-sm font-medium text-foreground`} href={href}>{content.actions.caseStudy}<Icon name="arrowRight" /></a>
              {project.url && <a class={`${linkText} text-sm font-medium text-foreground`} href={project.url} target="_blank" rel="noopener">{content.actions.visitSite}<Icon name="arrowUpRight" /></a>}
            </div>
          </div>
          <div data-reveal class="min-w-0 lg:col-span-7">
            {
              project.slug === "s-space" ? (
                <div class="grid gap-5 rounded-2xl border border-border-strong p-4 sm:p-6">
                  {project.decisions?.map((decision) => (
                    <div class="grid gap-2">
                      <h4 class="text-lg font-medium text-balance text-foreground">{decision.title}</h4>
                      <p class="text-base leading-relaxed text-pretty text-muted">{decision.body}</p>
                    </div>
                  ))}
                  <div><a class={`${linkText} text-sm font-medium text-foreground`} href="#simulation">{content.actions.seeSimulation}<Icon name="arrowRight" /></a></div>
                </div>
              ) : (
                <ArchitectureDiagram id={project.slug} collapseLabel={content.actions.viewArchitecture} />
              )
            }
          </div>
        </article>
      );
    })
  }
  </div>
  <div><a data-magnet class={btnOutline} href={localePath(locale, "/projects/")}>{content.actions.allProjects}<Icon name="arrowRight" /></a></div>
</section>

<section id="experience" data-globe="-1.35 -0.2 1.2 0.14" class="grid scroll-mt-20 gap-10 py-20 lg:py-28">
  <div class="grid gap-6">
    <p class={sectionLabel}><span class="text-primary">04</span><span data-scramble>{labels.experience}</span></p>
    <Title text={content.experience.title} class={sectionTitle} />
  </div>
  <div data-timeline class="timeline">
  <span class="timeline-track" aria-hidden="true"><span data-timeline-fill></span></span>
  <ol class="grid">
    {
      content.jobs.map((job) => (
        <li data-timeline-item class="timeline-item border-t border-border-strong"><div data-reveal class="grid gap-3 py-6 lg:grid-cols-[200px_minmax(0,1fr)_minmax(0,1fr)] lg:gap-8">
          <p class="text-sm text-muted">{job.date}</p>
          <div class="grid content-start gap-1">
            <h3 class="timeline-company w-fit text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">{job.company}</h3>
            <p class="text-sm text-foreground">{job.title}</p>
          </div>
          <div class="grid content-start gap-2">
            <p class="text-base leading-relaxed text-pretty text-muted">{job.note}</p>
            <p class="text-sm text-muted">{job.projects}</p>
          </div>
        </div></li>
      ))
    }
  </ol>
  </div>
  <div><a class={`${linkText} text-sm font-medium text-foreground`} href={localePath(locale, "/experience/")}>{content.actions.fullExperience}<Icon name="arrowRight" /></a></div>
</section>

<section id="contact" data-globe="0 -2.05 1.7 1" class="grid min-h-[80svh] scroll-mt-20 content-center justify-items-center gap-8 py-20 pb-40 text-center lg:py-28 lg:pb-52">
  <p class={sectionLabel}><span class="text-primary">05</span><span data-scramble>{labels.contact}</span></p>
  <div data-grow><Title text={content.contact.title} class="text-6xl leading-[1.02] font-bold tracking-[-0.045em] text-foreground sm:text-8xl lg:text-[10rem]" /></div>
  <a class={`${linkText} text-xl font-medium text-foreground sm:text-3xl`} href="mailto:contact@vinhnq.com">contact@vinhnq.com<Icon name="arrowUpRight" class="size-6 shrink-0" /></a>
  <div class="grid w-full max-w-sm grid-cols-2 gap-3 sm:flex sm:w-auto sm:max-w-none sm:flex-wrap sm:justify-center">
    <a data-magnet class={`${btnPrimary} col-span-2`} href={content.cvFile} download><Icon name="download" />{content.actions.downloadCv}</a>
    <a data-magnet class={btnOutline} href="https://github.com/Nqvinh7603">GitHub</a>
    <a data-magnet class={btnOutline} href="https://linkedin.com/in/nqvinh76">LinkedIn</a>
  </div>
</section>
