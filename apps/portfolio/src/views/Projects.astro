---
import Icon from "../components/Icon.astro";
import { getContent, localePath } from "../i18n";
import type { Locale } from "../i18n/types";
import { eyebrow, sectionTitle } from "../styles/classes";

type Props = { locale: Locale };

const { locale } = Astro.props;
const content = getContent(locale);
---

<section class="grid gap-4 py-12 lg:py-16">
  <p class={eyebrow}>{content.hero.eyebrow}</p>
  <h1 class={sectionTitle}>{content.projectsPage.title}</h1>
  <p class="max-w-prose text-base leading-relaxed text-pretty text-muted">{content.projectsPage.intro}</p>
</section>
<ol class="grid pb-16 lg:pb-24">
  {
    content.projects.map((project, index) => (
      <li data-reveal>
        <a href={localePath(locale, `/projects/${project.slug}/`)} class="group grid gap-3 border-t border-border-strong py-6 hover:bg-item-hover lg:grid-cols-[48px_minmax(0,1fr)_minmax(0,1fr)_24px] lg:gap-6 lg:px-3">
          <span class="text-sm text-muted">{String(index + 1).padStart(2, "0")}</span>
          <span class="grid content-start gap-1">
            <span class="w-fit text-xl font-semibold tracking-tight text-foreground transition-transform group-hover:translate-x-1" style={`view-transition-name: project-${project.slug}`}>{project.name}</span>
            <span class="text-sm text-pretty text-foreground">{project.domain}</span>
            <span class="text-sm text-pretty text-muted">{project.role} · {project.meta}</span>
          </span>
          <span class="grid content-start gap-2">
            <span class="text-base leading-relaxed text-pretty text-muted">{project.points[0]}</span>
            <span class="text-sm text-muted">{project.stack.join(" · ")}</span>
          </span>
          <span class="hidden text-muted group-hover:text-foreground lg:block"><Icon name="arrowRight" /></span>
        </a>
      </li>
    ))
  }
</ol>
