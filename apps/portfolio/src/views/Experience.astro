---
import Icon from "../components/Icon.astro";
import { getContent, localePath } from "../i18n";
import type { Locale } from "../i18n/types";
import { btnPrimary, eyebrow, sectionTitle } from "../styles/classes";

type Props = { locale: Locale };

const { locale } = Astro.props;
const content = getContent(locale);
const { experience } = content;
const nameToSlug = new Map(content.projects.map((project) => [project.name, project.slug]));
---

<section class="grid gap-4 py-12 lg:py-16">
  <p class={eyebrow}>{content.hero.eyebrow}</p>
  <h1 class={sectionTitle}>{experience.pageTitle}</h1>
  <p class="max-w-prose text-base leading-relaxed text-pretty text-muted">{experience.pageIntro}</p>
</section>
<ol class="grid">
  {
    content.jobs.map((job) => (
      <li data-reveal class="grid gap-3 border-t border-border-strong py-6 lg:grid-cols-[220px_minmax(0,1fr)_minmax(0,1fr)] lg:gap-8">
        <p class="text-sm text-muted">{job.date}</p>
        <div class="grid content-start gap-1">
          <h2 class="text-lg font-semibold text-foreground">{job.company}</h2>
          <p class="text-sm text-foreground">{job.title}</p>
        </div>
        <div class="grid content-start gap-2">
          <p class="text-base leading-relaxed text-pretty text-muted">{job.note}</p>
          <p class="flex flex-wrap gap-x-3 gap-y-1 text-sm text-muted">
            {job.projects.split(" · ").map((name) => {
              const slug = nameToSlug.get(name);
              return slug ? <a class="inline-flex min-h-8 items-center underline decoration-foreground/30 underline-offset-4 hover:text-foreground" href={localePath(locale, `/projects/${slug}/`)}>{name}</a> : <span>{name}</span>;
            })}
          </p>
        </div>
      </li>
    ))
  }
</ol>
<section class="grid gap-6 border-t border-border-strong py-12 lg:py-16">
  <h2 class="text-lg font-semibold text-foreground">{experience.openSourceTitle}</h2>
  <ul class="grid">
    {
      experience.openSource.map((item) => (
        <li data-reveal class="grid gap-3 border-t border-border-strong py-5 lg:grid-cols-[220px_minmax(0,1fr)_minmax(0,1fr)] lg:gap-8">
          <p class="text-sm text-muted">{item.date}</p>
          <div class="grid content-start gap-1">
            <h3 class="text-base font-semibold text-foreground">{item.project}</h3>
            <p class="text-sm text-muted">{item.language}</p>
          </div>
          <div class="grid content-start gap-2">
            <p class="text-base leading-relaxed text-pretty text-muted">{item.note}</p>
            <a class="inline-flex min-h-8 w-fit items-center text-sm text-muted underline decoration-foreground/30 underline-offset-4 hover:text-foreground" href={item.url} target="_blank" rel="noopener">{item.label}</a>
          </div>
        </li>
      ))
    }
  </ul>
</section>
<section class="grid gap-10 border-t border-border-strong py-12 lg:grid-cols-2 lg:gap-16 lg:py-16">
  <div class="grid content-start gap-4">
    <h2 class="text-lg font-semibold text-foreground">{experience.awardsTitle}</h2>
    <ul class="grid gap-2 text-base leading-relaxed text-pretty text-muted">
      {experience.awards.map((award) => <li>{award}</li>)}
    </ul>
  </div>
  <div class="grid content-start gap-4">
    <h2 class="text-lg font-semibold text-foreground">{experience.educationTitle}</h2>
    <ul class="grid gap-4">
      {
        experience.education.map((item) => (
          <li class="grid gap-1">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="text-sm font-semibold text-foreground">{item.school}</h3>
              <span class="text-sm text-muted">{item.date}</span>
            </div>
            <p class="text-sm text-muted">{item.detail}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
<div class="pb-16 lg:pb-24"><a class={btnPrimary} href={content.cvFile} download><Icon name="download" />{content.actions.downloadCv}</a></div>
